    {
      "parameters": {
        "jsCode": "const cfg=$('CONFIG').first().json;\nconst sources=$input.all()\n  .filter(x=>x.json?.status_only!==true && x.json?.article_enriched===true && Number(x.json?.source_content_chars||0)>=120)\n  .slice(0,Math.max(1,Number(cfg.max_items_per_run||1)))\n  .map((item,index)=>({...item.json,item_id:index}));\nif(!sources.length)return[];\n\nconst itemSchema={type:'object',additionalProperties:false,properties:{\n  item_id:{type:'integer'},importance:{type:'integer'},\n  category:{type:'string'},title_main:{type:'string'},title_highlight:{type:'string'},hook:{type:'string'},summary:{type:'string'},\n  bullet_1:{type:'string'},bullet_2:{type:'string'},bullet_3:{type:'string'},\n  source_name:{type:'string'},official_source_url:{type:'string'},\n  hashtags:{type:'array',items:{type:'string'},minItems:5,maxItems:8}\n},required:['item_id','importance','category','title_main','title_highlight','hook','summary','bullet_1','bullet_2','bullet_3','source_name','official_source_url','hashtags']};\nconst schema={type:'object',additionalProperties:false,properties:{results:{type:'array',minItems:1,items:itemSchema}},required:['results']};\n\nconst haberler=sources.map(s=>({\n  item_id:s.item_id,\n  source_title:String(s.title||''),\n  published:String(s.published||''),\n  link:String(s.official_source_url||s.link||''),\n  source_name:String(s.source_name||'Millî Eğitim Bakanlığı'),\n  source_article:String(s.source_content||'').replace(/\\s+/g,' ').slice(0,8500)\n}));\n\nconst prompt=[\n'EĞİTİM GÜNDEM 365 için profesyonel Türkçe haber editörüsün.',\n'SADECE source_article içindeki doğrulanmış gerçekleri kullan. Yeni bilgi, yorum, sonuç, tarih, sayı veya kişi UYDURMA.',\n'Her haber için TAM OLARAK şu alanları üret: item_id, importance, category, title_main, title_highlight, hook, summary, bullet_1, bullet_2, bullet_3, source_name, official_source_url, hashtags.',\n'',\n'ZORUNLU EDİTÖRYAL KURALLAR:',\n'- item_id girdideki item_id ile AYNI olacak.',\n'- official_source_url girdideki link ile AYNI olacak.',\n'- source_name girdideki source_name olacak.',\n'- title_main 28-60 karakter: BEYAZ ANA BAŞLIK. Haberin ana olayını sıfırdan ve profesyonel haber diliyle yaz.',\n'- title_highlight 18-55 karakter: SARI İKİNCİ BAŞLIK. title_main cümlesinin devamı OLAMAZ; ikinci bir açı, kapsam, sonuç veya önem bilgisi vermeli.',\n'- title_main + title_highlight kaynak başlığın aynısı, yakın kopyası veya rastgele ikiye bölünmüş hâli OLAMAZ.',\n'- source_title kelime sırasını ve cümle iskeletini KULLANMA.',\n'- source_title içinden art arda 3 anlamlı kelimeyi title_main/title_highlight içinde aynen kullanma.',\n'- title_main ile title_highlight aynı bilgiyi farklı kelimelerle tekrar ETMEYECEK.',\n'- YASAK örnek: source_title=\"Türkiye-Gürcistan eğitim iş birliği anlaşması imzalandı\" -> title_main=\"Türkiye-Gürcistan eğitim iş\" / title_highlight=\"birliği anlaşması imzalandı\".',\n'- DOĞRU örnek: title_main=\"Türkiye ile Gürcistan eğitimde yeni dönem başlattı\" / title_highlight=\"Anlaşma denkliği ve mesleki eğitimi kapsıyor\".',\n'- Haberin tam gövdesindeki iki farklı editoryal açıyı seç.',\n'- hook kısa önem cümlesi; iki başlığı tekrar etme.',\n'- summary 120-220 karakterlik profesyonel lead; kaynak cümlesini kopyalama.',\n'- bullet_1..3: 0-3 ayrı gerçek. Her biri \"Kısa alt başlık — tek cümle açıklama\" biçiminde. Bilgi yoksa boş string.',\n'- category yalnız: MÜFREDAT, ÖĞRETMEN, ÖĞRENCİ, SINAV, ATAMA, YÖNETİCİ, PROJE, TEKNOLOJİ, MESLEKİ EĞİTİM, ÖZEL EĞİTİM, MEVZUAT, DİĞER MEB.',\n'- importance 0-100 tamsayı.',\n'- hashtags 5-8 kısa etiket.',\n'- Markdown yok. Açıklama yok. YALNIZ geçerli JSON döndür: {\"results\":[...]}',\n'',\n'HABERLER='+JSON.stringify(haberler)\n].join('\\n');\n\nconst openai_body={\n  model:cfg.openai_model,\n  store:false,\n  reasoning:{effort:'low'},\n  max_output_tokens:Math.max(2200,Number(cfg.ai_max_output_tokens||3000)),\n  text:{format:{type:'json_schema',name:'eg365_newsroom_package',strict:true,schema}},\n  input:prompt\n};\nreturn [{json:{sources,openai_body,official_recent_mode:true,content_contract:'EG365_V117_PRO_NEWSROOM'}}];"
      },
