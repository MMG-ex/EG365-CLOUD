        "jsCode": "const __runMode=String($json?.run_mode||'normal');\nreturn [{json: {\n  run_mode: __runMode,\n  backfill_hours: 120,\n  backfill_max_per_run: 1,\n  build_tag: 'V128_CLOUD_DIRECT_OPENAI',\n  dry_run: false,\n  live_test_mode: true,\n  live_test_max_posts: 1,\n  crosspost_all_verified: true, // Seçilen doğrulanmış haber 4 platforma birlikte gider.\n  force_best_verified: false, // AI publish bayrağı vermese bile güvenli/doğrulanmış en iyi haberi seçer.\n  fail_open_source_reporting: false, // Tüm AI/OmniRoute sağlayıcıları düşerse kaynakta yazanı, açık SOURCE_REPORTED etiketiyle yayınlar.\n  fallback_min_confidence: 70,\n\n  openai_api_key: '__OPENAI_API_KEY__',\n  openai_model: 'gpt-5.4-mini',\n  openai_model_pool: ['gpt-5.4-mini','gpt-5.6-luna','gpt-5.6-sol','gpt-5.6-terra','gpt-6-astra'],\n  openai_router_enabled: true,\n\n  omniroute_enabled: false,\n  // OmniRoute REQUIRE_API_KEY=false ise any-string yeterlidir. Endpoint key kullanıyorsan burayı değiştir.\n  omniroute_api_key: 'any-string',\n  // auto/offline: yüksek kullanılabilirlik / kotası en rahat bağlı sağlayıcı.\n  omniroute_model: 'ddgw/mistral-small-2603',\n  omniroute_backup_model: 'ddgw/mistral-small-2603',\n  omniroute_timeout_ms: 120000,\n  openai_search_context: 'low',\n  ai_max_output_tokens: 3000,\n  ai_summary_chars: 500,\n\n  telegram_bot_token: '__TELEGRAM_BOT_TOKEN__',\n  telegram_chat_id: '__TELEGRAM_CHAT_ID__',\n  telegram_public_url: '__TELEGRAM_PUBLIC_URL__',\n\n  instagram_user_id: '__INSTAGRAM_USER_ID__',\n  instagram_access_token: '__INSTAGRAM_ACCESS_TOKEN__',\n  instagram_api_version: 'v23.0',\n\n  threads_user_id: '__THREADS_USER_ID__',\n  threads_access_token: '__THREADS_ACCESS_TOKEN__',\n  threads_api_version: 'v1.0',\n\n  facebook_user_access_token: '',\n  facebook_page_id: '__FACEBOOK_PAGE_ID__',\n  facebook_page_access_token: '__FACEBOOK_PAGE_ACCESS_TOKEN__',\n  facebook_api_version: 'v26.0',\n  public_image_host: 'catbox',\n  public_image_ttl: '72h',\n\n  look