    {
      "parameters": {
        "jsCode": "const cfg=$('CONFIG').first().json;\nconst meta=$('KAYNAKLARI ÜRET').all();\nconst store=$getWorkflowStaticData('global');\nstore.directSeen=store.directSeen||{};\nstore.publishedNews=store.publishedNews||{};\nconst now=Date.now();\nconst keepMs=Number(cfg.seen_keep_days||21)*86400000;\nfor(const [k,v] of Object.entries(store.directSeen)){ if(!v||now-Number(v)>keepMs) delete store.directSeen[k]; }\n\nfunction clean(s=''){return String(s||'').replace(/<[^>]*>/g,' ').replace(/\\s+/g,' ').trim();}\nfunction hash(s=''){let h=2166136261;for(let i=0;i<s.length;i++){h^=s.charCodeAt(i);h=Math.imul(h,16777619);}return(h>>>0).toString(16);}\nfunction canon(u=''){try{const x=new URL(u);x.hash='';x.search='';return(x.hostname+x.pathname.replace(/\\/$/,'')).toLowerCase();}catch(e){return String(u||'').toLowerCase();}}\nfunction articleUrl(u=''){return /^https:\\/\\/[^/]*meb\\.gov\\.tr\\/.*\\/(?:haber|icerik)\\/\\d+(?:\\/tr)?\\/?(?:[?#].*)?$/i.test(String(u||''));}\nfunction publishedKeys(url='',title='',source=''){return ['url:'+hash(canon(url)),'src-title:'+hash(clean(source).toLowerCase()+'|'+clean(title).toLowerCase())];}\n\nconst found=[];\nlet ok=0,failed=0,discovered=0,seen=0;\nconst inputs=$input.all();\nfor(let i=0;i<inputs.length;i++){\n  const j=inputs[i]?.json||{};\n  const md=meta[i]?.json||{};\n  const raw=String(j.raw||j.data||j.body||'');\n  if(!raw||j.error){failed++;continue;}\n  let obj=null;\n  try{obj=JSON.parse(raw);}catch(e){failed++;continue;}\n  if(obj?.ok!==true||!Array.isArray(obj.items)){failed++;continue;}\n  ok++;\n  for(const v of obj.items){\n    const link=String(v.link||v.official_source_url||'').trim();\n    const title=clean(v.title);\n    if(!title||!articleUrl(link))continue;\n    discovered++;\n    const source=clean(v.source_name||md.source_name||'Millî Eğitim Bakanlığı');\n    const keys=publishedKeys(link,title,source);\n    const directKey=hash(canon(link)+'|'+title.toLocaleLowerCase('tr-TR'));\n    if(store.directSeen[directKey]||keys.some(k=>store.publishedNews[k])){seen++;continue;}\n    const full=clean(v.source_content||v.summary||'');\n    found.push({json:{\n      title,link,official_source_url:link,\n      published:String(v.published||''),\n      summary:clean(v.summary||'').slice(0,2400),\n      source_content:full.slice(0,9000),\n      source_page_summary:clean(v.summary||''),\n      source_image_url:String(v.source_image_url||''),\n      source_image_credit:clean(v.source_image_credit||source),\n      source_name:source,\n      source_host:md.source_host||'',\n      source_type:'DISCOVER',\n      verified:true,meb_relevant:true,\n      direct_seen_key:directKey,\n      ts:Number(v.ts||0)||now,\n      article_enriched:full.length>=120,\n      article_fetch_ok:full.length>=120\n    }});\n  }\n}\nconst uniq=new Map();\nfor(const x of found){\n  const k=canon(x.json.link);\n  if(!uniq.has(k))uniq.set(k,x);\n}\nconst arr=[...uniq.values()].sort((a,b)=>Number(b.json.ts||0)-Number(a.json.ts||0));\nconst maxPick=Math.max(1,Number(cfg.max_items_per_run||3));\nconst picked=arr.slice(0,maxPick);\nif(!picked.length){\n  return [{json:{status_only:true,run_mode:String(cfg.run_mode||'normal'),DURUM:'RESMÎ MEB KAYNAKLARI TARANDI — YENİ YAYIN ADAYI YOK',publish_telegram:false,publish_instagram:false,publish_threads:false,publish_facebook:false,scan_debug:{input:inputs.length,ok,failed,discovered,seen,eligible:0,picked:0}}}];\n}\nreturn picked.map((x,i)=>({json:{...x.json,item_id:i,run_mode:String(cfg.run_mode||'normal'),scan_debug:{input:inputs.length,ok,failed,discovered,seen,eligible:arr.length,picked:picked.length}}}));"
      },
