    {
      "parameters": {
        "jsCode": "const cfg=$('CONFIG').first().json;\nconst telegramPublicUrl=String(cfg.telegram_public_url||'https://t.me/egitimgundem365').trim();\nconst telegramCta=`📲 Detaylar Telegram'da: ${telegramPublicUrl}`;\n\nfunction extract(resp){\n  if(!resp)return'';\n  if(typeof resp.output_text==='string')return resp.output_text;\n  for(const o of(resp.output||[]))for(const c of(o.content||[]))if(c.type==='output_text'&&c.text)return c.text;\n  if(Array.isArray(resp.choices))return String(resp.choices?.[0]?.message?.content||'');\n  return'';\n}\nfunction cleanJsonText(s=''){return String(s).replace(/^```(?:json)?\\s*/i,'').replace(/\\s*```$/,'').trim();}\nfunction cleanText(s=''){return String(s).replace(/<[^>]*>/g,' ').replace(/&nbsp;/g,' ').replace(/&amp;/g,'&').replace(/&#39;/g,\"'\").replace(/&quot;/g,'\"').replace(/\\s+/g,' ').trim();}\nfunction officialUrl(url=''){try{const u=new URL(String(url||''));const h=String(u.hostname||'').toLowerCase();return h==='meb.gov.tr'||h.endsWith('.meb.gov.tr');}catch(e){return false;}}\nfunction googleNewsUrl(url=''){return /^https?:\\/\\/(?:news\\.)?google\\.com\\//i.test(String(url||''));}\nfunction directUrl(url=''){return /^https?:\\/\\//i.test(String(url||'')) && !googleNewsUrl(url);}\nfunction officialBonus(url=''){\n  const u=String(url).toLowerCase();\n  if(/meb\\.gov\\.tr\\//.test(u))return 20;\n  if(/resmigazete\\.gov\\.tr|osym\\.gov\\.tr|\\.gov\\.tr\\//.test(u))return 15;\n  return 0;\n}\nfunction escHtml(s=''){return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}\nfunction escAttr(s=''){return String(s).replace(/&/g,'&amp;').replace(/\"/g,'&quot;');}\nfunction uniqueUrls(arr=[]){const out=[];const seen=new Set();for(const u of arr){const s=String(u||'').trim();if(!/^https?:\\/\\//i.test(s))continue;const k=s.toLowerCase();if(seen.has(k))continue;seen.add(k);out.push(s);}return out;}\nfunction bestSourceUrl(data={},src={}){\n  const list=uniqueUrls([\n    data.official_source_url,\n    data.source_url,\n    ...(Array.isArray(data.related_urls)?data.related_urls:[]),\n    src.official_source_url,\n    ...(Array.isArray(src.related_urls)?src.related_urls:[]),\n    src.link\n  ]);\n  const official=list.find(officialUrl);\n  if(official) return official;\n  const direct=list.find(directUrl);\n  if(direct) return direct;\n  return list[0]||'';\n}\nfunction relatedSourceUrls(mainUrl,data={},src={}){\n  return uniqueUrls([...(Array.isArray(data.related_urls)?data.related_urls:[]),...(Array.isArray(src.related_urls)?src.related_urls:[]),src.link]).filter(u=>u!==mainUrl && !googleNewsUrl(u)).slice(0,2);\n}\nfunction categoryOf(t=''){\n  t=String(t).toLocaleLowerCase('tr-TR');\n  if(/atama|tayin|yer değiş|norm kadro|personel|öğretmen alım/.test(t))return'Atama & Personel';\n  // Kurum adlarındaki “Genel Müdürlüğü” sözcüğü yönetici haberi sayılmaz.\n  // Yalnızca gerçek yönetici/pozisyon ifadeleri bu kategoriye girer.\n  if(/okul müdürü|müdür yardımcısı|şube müdürü|yönetici görevlendirme|yönetici atama|yönetici seçme|yönetici değerlendirme|eğitim kurumu yönetic/.test(t))return'Yönetici Görevlendirme';\n  if(/yönetmelik|mevzuat|yönerge|genelge|resm.? gazete|tebliğ/.test(t))return'Mevzuat & Resmî Gazete';\n  // Türkçe küçük harfe dönüşümde I -> ı olduğu için uluslararası kısaltmaların iki yazımı da desteklenir.\n  if(/(?:^|[^a-z0-9çğıöşü])(?:isa|ısa)(?=$|[^a-z0-9çğıöşü])|pisa|pısa|timss|tımss|pirls|pırls|lgs|iokbs|sınav|ortak yazılı|ölçme|değerlendirme|kpss|araştırma sonuç/.test(t))return'Sınav & Ölçme';\n  if(/eba|e-okul|e okul|mebbis|öba|mebi/.test(t))return'EBA/e-Okul/MEBBİS';\n  if(/yapay zek|teknoloji|yegitek|fatih|dijital|siber/.test(t))return'Teknoloji & Yapay Zekâ';\n  if(/müfredat|maarif|tymm|öğretim program|ders program/.test(t))return'Müfredat & TYMM';\n  if(/mesleki|mesem|meslek lises/.test(t))return'Meslekî Eğitim';\n  if(/özel eğitim|ram\\b|bilsem|kaynaştırma/.test(t))return'Özel Eğitim & Rehberlik';\n  if(/burs|pansiyon|yurt dış/.test(t))return'Burs & Yurt Dışı';\n  if(/tatil|takvim|eğitim öğretim yılı/.test(t))return'Takvim & Tatil';\n  return'Diğer MEB';\n}\nfunction sentences(s=''){\n  const txt=cleanText(s);\n  const parts=txt.split(/(?<=[.!?])\\s+/).map(x=>x.trim()).filter(x=>x.length>18);\n  if(parts.length)return parts.slice(0,4);\n  return txt?[txt]:[];\n}\nfunction sameish(a='',b=''){\n  const x=cleanText(a).toLocaleLowerCase('tr-TR');\n  const y=cleanText(b).toLocaleLowerCase('tr-TR');\n  if(!x||!y)return false;\n  if(x===y)return true;\n  return x.includes(y)||y.includes(x);\n}\nfunction uniqFacts(list=[], refs=[]){\n  const out=[];\n  for(const raw of (list||[])){\n    const t=cleanText(raw);\n    if(!t)continue;\n    if(sourceLikeV89(t,''))continue;\n    if(refs.some(r=>sameish(t,r)))continue;\n    if(out.some(v=>sameish(v,t)))continue;\n    out.push(t);\n    if(out.length>=3)break;\n  }\n  return out;\n}\nfunction pickLead(candidates=[], title=''){\n  for(const c of candidates||[]){\n    const t=cleanText(c);\n    if(!t)continue;\n    if(sameish(t,title))continue;\n    return t.slice(0,190);\n  }\n  return '';\n}\nfunction publisherFromTitle(title=''){\n  const t=cleanText(title);\n  const m=t.match(/\\s[-–—]\\s([^\\-–—]{2,60})$/);\n  return m?m[1].trim():'';\n}\nfunction stripPublisher(title=''){return cleanText(title).replace(/\\s[-–—]\\s[^\\-–—]{2,60}$/,'').trim();}\nfunction relevance(text=''){return /\\b(meb|milli eğitim|millî eğitim|öğretmen|öğrenci|okul|lgs|iokbs|eba|e okul|e-okul|mebbis|öba|mebi|müfredat|maarif|yönetmelik|yönerge|genelge|atama|görevlendirme|sınav|mesleki eğitim|özel eğitim|bilsem|ram|fatih|yegitek|mesem|akademi|burs|pansiyon|kpss)\\b/i.test(cleanText(text));}\nfunction makeSourceFallback(src,reason){\n  if(!src)return null;\n  const full=cleanText((src.title||'')+' '+(src.summary||''));\n  const isOfficial=officialUrl(src.link||src.official_source_url||'');\n  // Bu node'a ulaşan kaynaklar ÖN FİLTRE tarafından resmî MEB olarak doğrulanmıştır.\n  // AI, resmî kaynağı yanlışlıkla 'ilgili değil/doğrulanmadı' dese bile haberi veto edemez.\n  if(!isOfficial && cfg.fail_open_source_reporting!==true && !relevance(full))return null;\n  const ss=sentences(src.summary||'');\n  let bullets=ss.filter(x=>!sourceLikeV89(x,src.source_name||'')).slice(0,3);\n  const pub=publisherFromTitle(src.title||'');\n  return {\n    item_id:Number(src.item_id||0),\n    meb_relevant:true,\n    verified:isOfficial,\n    source_reported:!isOfficial,\n    confidence:isOfficial?94:74,\n    importance:Number(src.important||0)?78:55,\n    category:categoryOf(full),\n    title_main:stripPublisher(src.title||'').slice(0,112),\n    title_highlight:'',\n    lead:(ss[0]||stripPublisher(src.title||'')).slice(0,190),\n    bullets:bullets.map(x=>cleanText(x).slice(0,180)).filter(Boolean).slice(0,3),\n    source_name:isOfficial?(/osym/i.test(src.link||'')?'ÖSYM Başkanlığı':(/resmigazete/i.test(src.link||'')?'Resmî Gazete':'Millî Eğitim Bakanlığı')):(pub||'Haber kaynağı'),\n    official_source_url:isOfficial?String(src.link||src.official_source_url||''):'',\n    related_urls:[],\n    hashtags:['#MEB','#Eğitim','#MilliEğitim','#EğitimGündemi','#Öğretmen'],\n    publish_telegram:true,publish_instagram:true,\n    _ai_status:'SOURCE_FALLBACK_'+reason,\n    _publication_basis:isOfficial?'OFFICIAL_SOURCE_FALLBACK':'SOURCE_REPORTED_FALLBACK'\n  };\n}\nfunction normalize(data,src){\n  const d={...(data||{})};\n  d.item_id=Number(d.item_id??src?.item_id??0);\n  if(src){\n    d.meb_relevant=true;\n    d.verified=true;\n    d.source_reported=false;\n    d.confidence=Math.max(100,Number(d.confidence||0));\n    d.publish_telegram=true;\n    d.publish_instagram=true;\n    d.official_source_url=String(src.official_source_url||src.link||d.official_source_url||'');\n    d.source_name=cleanText(src.source_name||d.source_name||'Millî Eğitim Bakanlığı');\n  }\n  d.title_main=cleanText(d.title_main||'');\n  d.title_highlight=cleanText(d.title_highlight||'');\n  d.lead=cleanText(d.lead||'');\n  if(!d.lead || sameish(d.lead,d.title_main)){\n    d.lead=pickLead([\n      d.summary,\n      ...(Array.isArray(src?.summary)?src.summary:[src?.summary]),\n      src?.source_content,\n      src?.description,\n      src?.contentSnippet\n    ], d.title_main) || d.title_main;\n  }\n  let b=Array.isArray(d.bullets)?d.bullets.map(cleanText).filter(Boolean):[];\n  b=uniqFacts(b,[d.title_main,d.lead]).filter(x=>!sourceLikeV89(x,d.source_name||'')).slice(0,3);\n  d.bullets=b.map(x=>x.slice(0,160));\n  const _cats=new Set(['MÜFREDAT','ÖĞRETMEN','ÖĞRENCİ','SINAV','ATAMA','YÖNETİCİ','PROJE','TEKNOLOJİ','MESLEKİ EĞİTİM','ÖZEL EĞİTİM','MEVZUAT','DİĞER MEB']); if(!_cats.has(cleanText(d.category||'').toLocaleUpperCase('tr-TR')))d.category=categoryOf((src?.title||'')+' '+(src?.summary||''));\n  if(!cleanText(d.source_name||''))d.source_name=publisherFromTitle(src?.title||'')||'Haber kaynağı';\n  if(!Array.isArray(d.hashtags)||d.hashtags.filter(Boolean).length<5)d.hashtags=['#MEB','#Eğitim','#MilliEğitim','#EğitimGündemi','#Öğretmen'];\n  if(!Array.isArray(d.related_urls))d.related_urls=[];\n  d.publish_telegram=true;\n  d.publish_instagram=true;\n  d.publish_threads=true;\n  d.publish_facebook=true;\n  return d;\n}\n\nconst response=$input.first()?.json||{};\nconst bundle=$('OPENAI TOPLU İSTEK HAZIRLA').first().json||{};\nconst sources=(bundle.sources||[]).map((s,i)=>({...s,item_id:Number.isFinite(Number(s.item_id))?Number(s.item_id):i}));\nconst sourceById=new Map(sources.map((s,i)=>[Number(s.item_id??i),s]));\nlet rawResults=[];\nlet aiStatus='AI_OK';\nlet aiError='';\nconst aiModelUsed=response._router_model||response.model||'unknown';\n\nif(response.error){\n  aiError=String(response.error.message||response.error.description||'API_ERROR');\n  aiStatus=/rate limit|too many requests|429/i.test(aiError)?'RATE_LIMIT_429':'API_ERROR';\n}else{\n  try{\n    const parsed=JSON.parse(cleanJsonText(extract(response)));\n    rawResults=Array.isArray(parsed.results)?parsed.results:[];\n  }catch(e){aiStatus='JSON_PARSE_ERROR';aiError=String(e.message||e);}\n}\n\nlet results=[];\nfor(const r of rawResults){\n  const id=Number(r?.item_id);\n  const ru=String(r?.official_source_url||r?.source_url||'').trim().toLowerCase();\n  const src=sourceById.get(id)\n    || sources.find(s=>ru && String(s.official_source_url||s.link||'').trim().toLowerCase()===ru)\n    || (sources.length===1?sources[0]:sources[id]);\n  if(src)results.push(normalize(normalizeV89Result(r),src));\n}\nif(!results.length){\n  return [{json:{status_only:true,DURUM:'AI EDİTÖR ÇIKTISI YOK — KAYNAK METİN KOPYASI YAYINLANMADI',ai_status:aiStatus,ai_error:aiError,ai_model_used:aiModelUsed,incelenen_haber_sayisi:sources.length,publish_telegram:false,publish_instagram:false,publish_threads:false,publish_facebook:false}}];\n}\n\nfunction editorialTokens(s=''){\n  return cleanText(s).toLocaleLowerCase('tr-TR').normalize('NFKD').replace(/[\\u0300-\\u036f]/g,'').replace(/[^a-z0-9çğıöşü\\s]/gi,' ').split(/\\s+/).filter(x=>x.length>=3);\n}\nfunction editorialSimilarity(a='',b=''){\n  const A=editorialTokens(a),B=editorialTokens(b); if(!A.length||!B.length)return 0;\n  const ca={}; for(const x of A)ca[x]=(ca[x]||0)+1; const cb={}; for(const x of B)cb[x]=(cb[x]||0)+1;\n  let dot=0,aa=0,bb=0; for(const k of Object.keys(ca)){aa+=ca[k]*ca[k];dot+=ca[k]*(cb[k]||0);} for(const k of Object.keys(cb))bb+=cb[k]*cb[k];\n  return dot/(Math.sqrt(aa*bb)||1);\n}\nconst eligible=[];\n// V77: OPENAI TOPLU İSTEK HAZIRLA içindeki sources dizisi zaten resmî MEB filtresinden gelmiştir.\n// Bu nedenle aday seçimi AI'nin meb_relevant/verified/confidence kararına bağlı değildir.\nfor(const src of sources){\n  if(src.article_enriched!==true || Number(src.source_content_chars||0)<120) continue;\n  const itemId=Number(src.item_id||0);\n  const aiData=results.find(x=>Number(x?.item_id)===itemId)||null;\n  if(!aiData) continue;\n  const data=normalize(normalizeV89Result(aiData||{}),src);\n  const sourceUrl=bestSourceUrl(data,src);\n  if(!/^https?:\\/\\//i.test(sourceUrl))continue;\n  if(!sourceUrl)continue;\n  let bullets=(data.bullets||[]).map(x=>cleanText(x)).filter(Boolean).filter(x=>!sourceLikeV89(x,data.source_name||src.source_name||'')).slice(0,3);\n  data.bullets=bullets;\n  if(!cleanText(data.title_main||'')||!cleanText(data.title_highlight||''))continue;\n  if(!cleanText(data.lead||''))data.lead=(sentences(src.summary||'')[0]||stripPublisher(src.title||'')).slice(0,190);\n  if(!cleanText(data.category||''))data.category=categoryOf((src.title||'')+' '+(src.summary||''));\n  data.meb_relevant=true;\n  data.verified=true;\n  data.source_reported=false;\n  data.confidence=100;\n  data.publish_telegram=true;\n  data.publish_instagram=true;\n  data.official_source_url=sourceUrl;\n  const title=[data.title_main,data.title_highlight].filter(Boolean).join(': ').trim();\n  if(!title)continue;\n  const sourceTitle=stripPublisher(src.title||'');\n  const sourceSummary=cleanText(src.source_content||src.summary||'').slice(0,12000);\n  const titleSimilarity=editorialSimilarity(title,sourceTitle);\n  const srcSentences=sourceSummary.split(/(?<=[.!?])\\s+/).map(x=>cleanText(x)).filter(x=>x.length>=30).slice(0,30);\n  const leadSentenceSimilarity=srcSentences.length?Math.max(...srcSentences.map(s=>editorialSimilarity(data.lead||'',s))):0;\n  const leadSimilarity=editorialSimilarity(data.lead||'',sourceSummary);\n  const titleExactish=sameish(title,sourceTitle);\n  const leadExactish=srcSentences.some(s=>sameish(data.lead||'',s));\n  const mainTitle=cleanText(data.title_main||'');\n  const highlightTitle=cleanText(data.title_highlight||'');\n  const sourceMainSimilarity=editorialSimilarity(mainTitle,sourceTitle);\n  const sourceHighlightSimilarity=editorialSimilarity(highlightTitle,sourceTitle);\n  const partsSimilarity=editorialSimilarity(mainTitle,highlightTitle);\n  const continuationTrap=sameish((mainTitle+' '+highlightTitle).trim(),sourceTitle);\n  const actualAiResult=!!aiData && aiStatus==='AI_OK' && mainTitle.length>=20 && highlightTitle.length>=12 && cleanText(data.lead||'').length>=55;\n  const articleReady=src.article_enriched===true && Number(src.source_content_chars||0)>=120;\n  const editorialPass=actualAiResult && articleReady\n    && !titleExactish && !continuationTrap\n    && titleSimilarity<0.84\n    && sourceMainSimilarity<0.84\n    && sourceHighlightSimilarity<0.80\n    && partsSimilarity<0.70\n    && leadSentenceSimilarity<0.94;\n  if(!editorialPass) continue;\n  data.editorial_quality_pass=true;\n  data.title_similarity=Number(titleSimilarity.toFixed(3));\n  data.lead_similarity=Number(leadSimilarity.toFixed(3));\n  data.lead_sentence_similarity=Number(leadSentenceSimilarity.toFixed(3));\n  const score=100 + Number(data.importance||0)*0.55 + officialBonus(sourceUrl) + 12 + Number(src.priority||0)*5 + Number(src.important||0)*7;\n  eligible.push({data,src,sourceUrl,title,bullets:data.bullets.slice(0,3),score});\n}\n\neligible.sort((a,b)=>b.score-a.score);\nif(!eligible.length){\n  return [{json:{status_only:true,DURUM:'EDİTÖRYAL KALİTE KAPISINI GEÇEN HABER YOK — YAYIN YAPILMADI',ai_status:aiStatus,ai_error:aiError,ai_model_used:aiModelUsed,incelenen_haber_sayisi:sources.length,source_debug:sources.map(s=>({title:s.title,link:s.link,official_source_url:s.official_source_url})),publish_telegram:false,publish_instagram:false,publish_threads:false,publish_facebook:false}}];\n}\n\nconst pick=eligible[0];\nconst data=pick.data,src=pick.src,sourceUrl=pick.sourceUrl,bullets=pick.bullets,title=pick.title;\nconst related=relatedSourceUrls(sourceUrl,data,src);\nconst tags=(data.hashtags||[]).map(x=>String(x).trim()).filter(Boolean).map(x=>x.startsWith('#')?x:'#'+x.replace(/\\s+/g,'')).slice(0,10);\nwhile(tags.length<5){for(const t of ['#MEB','#Eğitim','#MilliEğitim','#EğitimGündemi','#Öğretmen']){if(!tags.includes(t))tags.push(t);if(tags.length>=5)break;}}\nconst verified=data.verified===true;\nconst basis=verified?'AI/RESMÎ KAYNAK DOĞRULAMASI':'KAYNAK HABERİ — AI SERVİSİ GEÇİCİ OLARAK KULLANILAMADI';\nconst sourceLabel=verified?'Resmî / doğrulanmış kaynak':'Kaynak haberi';\nconst insta=[title,'',data.lead,...(bullets.length?['',...bullets.map(x=>'• '+x)]:[]),'',`Kaynak: ${data.source_name||'Haber kaynağı'}`,'',telegramCta,'',tags.join(' ')].join('\\n').slice(0,2100);\nconst tgPlain=[`📢 ${data.category||categoryOf(title)}`,title,'',data.lead,...(bullets.length?['',...bullets.map(x=>'• '+x)]:[]),'',`🔗 ${sourceLabel}: ${sourceUrl}`,...(verified?[]:['','ℹ️ Not: Bu paylaşım kaynak haberine dayanır; AI doğrulama servisi bu turda kullanılamadı.'])].join('\\n').slice(0,1000);\nconst tgHtml=[\n  `📢 ${escHtml(data.category||categoryOf(title))}`,\n  escHtml(title),\n  '',\n  escHtml(data.lead),\n  ...(bullets.length?['',...bullets.map(x=>'• '+escHtml(x))]:[]),\n  '',\n  `🔗 <a href=\"${escAttr(sourceUrl)}\">${escHtml(sourceLabel)}</a>`,\n  ...(verified?[]:['','ℹ️ ' + escHtml('Bu paylaşım kaynak haberine dayanır; AI doğrulama servisi bu turda kullanılamadı.')])\n].join('\\n').slice(0,1020);\nconst th=[title,'',data.lead,...(bullets.length?['',...bullets.slice(0,2).map(x=>'• '+x)]:[]),'',`Kaynak: ${sourceUrl}`,'',telegramCta].join('\\n').slice(0,480);\nconst fb=[title,'',data.lead,...(bullets.length?['',...bullets.map(x=>'• '+x)]:[]),'',`🔗 ${sourceLabel}: ${sourceUrl}`,...(verified?[]:['ℹ️ Kaynak haberi; AI doğrulama servisi bu turda kullanılamadı.']),'',telegramCta,'',tags.join(' ')].join('\\n').slice(0,4000);\n\nreturn [{json:{\n  ...src,...data,\n  status_only:false,\n  ai_status:data._ai_status||aiStatus,\n  ai_error:aiError,\n  ai_model_used:aiModelUsed,\n  publication_basis:basis,\n  selection_score:Math.round(pick.score*10)/10,\n  selection_reason:'EN_YUKSEK_UYGUNLUK_PUANI',\n  title,\n  bullets,\n  bullet_1:bullets[0]||'',bullet_2:bullets[1]||'',bullet_3:bullets[2]||'',bullet_count:bullets.length,\n  content_quality_pass:true,content_quality_version:'V113_NEWSROOM_EDITORIAL_GATE',\n  hashtags:tags,\n  source_url:sourceUrl,\n  preferred_source_url:sourceUrl,\n  source_related_urls:related,\n  publish_telegram:true,\n  publish_instagram:true,\n  publish_threads:true,\n  publish_facebook:true,\n  instagram_caption:insta,\n  telegram_caption:tgPlain,\n  telegram_caption_html:tgHtml,\n  threads_caption:th,\n  facebook_caption:fb\n}}]\nfunction normalizeV89Result(r={}){\n  if(r.title_main!==undefined || r.title_highlight!==undefined || r.title!==undefined || r.summary!==undefined || r.bullet_1!==undefined){\n    const main=cleanText(r.title_main||r.title||'');\n    const hi=cleanText(r.title_highlight||'');\n    const full=[main,hi].filter(Boolean).join(' ');\n    const lead=pickLead([r.summary,r.hook], full) || cleanText(r.summary||'') || full;\n    const rawBullets=Array.isArray(r.maddeler)?r.maddeler:[r.bullet_1,r.bullet_2,r.bullet_3];\n    const b=uniqFacts(rawBullets,[main,hi,lead]);\n    return {...r,meb_relevant:true,verified:true,confidence:100,title_main:main,title_highlight:hi,lead,bullets:b.slice(0,3),publish_telegram:true,publish_instagram:true};\n  }\n  return r;\n}\nfunction sourceLikeV89(s='',source=''){\n const t=cleanText(s).toLocaleLowerCase('tr-TR'); const sn=cleanText(source).toLocaleLowerCase('tr-TR');\n return !!t && (/kaynak kurum|resm[iî] kaynak|ayr[iı]nt[iı]lar .*kaynak|resm[iî] kaynakta|taraf[iı]ndan (?:yay[iı]mland[iı]|yay[iı]nland[iı]|duyuruldu|payla[sş][iı]ld[iı])/.test(t)||(sn&&t===sn));\n}\n;"
      },
